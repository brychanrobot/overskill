# Convex Deployment URL (Retrieved from `npx convex dev` or Convex Dashboard)
PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Clerk Authentication (Retrieved from Clerk Dashboard -> API Keys)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Frontend API URL (Configured on Convex Backend via `npx convex env set CLERK_FRONTEND_API_URL <url>`)
# CLERK_FRONTEND_API_URL=https://verb-noun-00.clerk.accounts.dev
